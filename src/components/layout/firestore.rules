rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user has admin role
    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper function to check if user has instructor role
    function isInstructor() {
      return request.auth != null &&
             (request.auth.token.role == 'instructor' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor');
    }

    // Helper function to check if user has student role
    function isStudent() {
      return request.auth != null &&
             (request.auth.token.role == 'student' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student');
    }

    // Users collection
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if request.auth != null &&
                           request.auth.uid == userId;

      // Allow reading user profiles for role checking (fallback to Firestore data)
      allow read: if request.auth != null;

      // Instructors can read students assigned to them
      allow read: if isInstructor() &&
                    resource.data.assignedInstructor == request.auth.uid;

      // Allow server-side creation (for admin API routes)
      allow create: if request.auth != null;
    }

    // Courses collection
    match /courses/{courseId} {
      // All authenticated users can read courses
      allow read: if request.auth != null;

      // Allow authenticated users to create/modify for development
      // In production, restrict to admins only
      allow write: if request.auth != null;
    }

    // Course assignments collection
    match /courseAssignments/{assignmentId} {
      // Allow authenticated users to read assignments
      // Client-side AuthGuard handles specific permissions
      allow read: if request.auth != null;

      // Allow authenticated users to create assignments
      allow create: if request.auth != null;

      // Allow authenticated users to update assignments
      allow update: if request.auth != null;

      // Allow delete for cleanup
      allow delete: if request.auth != null;
    }

    // Enrollments collection (legacy - keeping for backward compatibility)
    match /enrollments/{enrollmentId} {
      allow read, write: if request.auth != null;
    }
  }
}