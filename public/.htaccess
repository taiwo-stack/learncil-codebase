# BEGIN Gzip Compression
<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and fonts
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByTypeType DEFLATE application/rss+xml
  AddOutputFilterByTypeType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByTypeType DEFLATE application/x-font
  AddOutputFilterByTypeType DEFLATE application/x-font-opentype
  AddOutputFilterByTypeType DEFLATE application/x-font-otf
  AddOutputFilterByTypeType DEFLATE application/x-font-truetype
  AddOutputFilterByTypeType DEFLATE application/x-font-ttf
  AddOutputFilterByTypeType DEFLATE application/x-javascript
  AddOutputFilterByTypeType DEFLATE application/xhtml+xml
  AddOutputFilterByTypeType DEFLATE application/xml
  AddOutputFilterByTypeType DEFLATE font/opentype
  AddOutputFilterByTypeType DEFLATE font/otf
  AddOutputFilterByTypeType DEFLATE font/ttf
  AddOutputFilterByTypeType DEFLATE image/svg+xml
  AddOutputFilterByTypeType DEFLATE image/x-icon
  AddOutputFilterByTypeType DEFLATE text/css
  AddOutputFilterByTypeType DEFLATE text/html
  AddOutputFilterByTypeType DEFLATE text/javascript
  AddOutputFilterByTypeType DEFLATE text/plain
  AddOutputFilterByTypeType DEFLATE text/xml
</IfModule>
# END Gzip Compression

# BEGIN Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access 1 year"
  ExpiresByType image/jpeg "access 1 year"
  ExpiresByType image/gif "access 1 year"
  ExpiresByType image/png "access 1 year"
  ExpiresByType image/webp "access 1 year"
  ExpiresByType image/svg+xml "access 1 month"
  ExpiresByType image/x-icon "access 1 year"
  ExpiresByType video/mp4 "access 1 year"
  ExpiresByType video/mpeg "access 1 year"
  ExpiresByType text/css "access 1 month"
  ExpiresByType text/html "access 1 month"
  ExpiresByType text/javascript "access 1 month"
  ExpiresByType application/javascript "access 1 month"
  ExpiresByType application/pdf "access 1 month"
  ExpiresByType application/x-shockwave-flash "access 1 month"
  ExpiresByType application/x-javascript "access 1 month"
  ExpiresByType application/xml "access 1 hour"
  ExpiresByType application/json "access 1 hour"
</IfModule>
# END Browser Caching

# BEGIN Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
# END Security Headers

# BEGIN WWW Redirect (optional - uncomment if needed)
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^learncil\.com [NC]
# RewriteRule ^(.*)$ https://www.learncil.com/$1 [L,R=301]
# END WWW Redirect

# BEGIN HTTPS Redirect
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
# END HTTPS Redirect