rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow admins to perform full CRUD operations on all user documents
    match /users/{userId} {
      allow read, write, create, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Appointments collection - allow create for all, authenticated users and admins can read/write
    match /appointments/{appointmentId} {
      // Allow anyone to create appointments
      allow create: if true;
      // Allow admins to read/write all appointments
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Allow instructors to read/write appointments assigned to them (for status updates)
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor' &&
        resource.data.assignedInstructor == request.auth.uid;
      // Allow users to read/write appointments where email matches their user document email
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.email;
    }

    // Courses collection - admin full access, instructors limited access, students read-only
    match /courses/{courseId} {
      // Admins can do everything
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Instructors can read all courses, but only write their own
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor';
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor' &&
        request.auth.uid == resource.data.instructorId;

      // Students can only read published courses
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
        resource.data.status == 'published';
    }

    // Course enrollments collection
    match /enrollments/{enrollmentId} {
      // Users can read/write their own enrollments
      allow read, write: if request.auth != null && request.auth.uid == resource.data.studentId;

      // Admins can read all enrollments
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Instructors can read enrollments for their courses
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor' &&
        exists(/databases/$(database)/documents/courses/$(resource.data.courseId)) &&
        get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.instructorId == request.auth.uid;
    }

    // Allow authenticated users to read/write their own data in other collections
    // Add more specific rules as needed for courses, assignments, etc.
   }
}